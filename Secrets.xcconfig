// Secrets.xcconfig
// Injected into Info.plist at build time via $(VARIABLE_NAME) references.
// DO NOT commit this file with real values to source control.
// Replace YOUR_* placeholders before building.

// Firebase Cloud Function base URL (the generateJourneyHTTP endpoint URL)
// Format: https://us-central1-PROJECT_ID.cloudfunctions.net/generateJourneyHTTP
CLOUD_FUNCTION_URL = https:/$()/us-central1-abidejourney-81288.cloudfunctions.net/generateJourneyHTTP

// Shared secret between the iOS app and Cloud Functions (must match APP_SECRET in firebase/functions/.env)
// Generate with: uuidgen or openssl rand -hex 32
APP_SECRET = YOUR_APP_SECRET

// TelemetryDeck App ID (get from https://dashboard.telemetrydeck.com after creating your app)
TELEMETRYDECK_APP_ID = YOUR_TELEMETRYDECK_APP_ID
